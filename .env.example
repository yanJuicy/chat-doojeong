# app/config.py 참고
LLM_PROVIDER_BASE_URL=http://localhost:11434
# 현재 컴2(RTX 5060 8GB) 기준. 더 작은 VRAM에서는 qwen3:4b를 검토한다.
LLM_MODEL_NAME=qwen3:8b

EMBEDDING_MODEL_DIR=./models/bge-m3
EMBEDDING_USE_GPU=true

RERANKER_MODEL_DIR=./models/bge-reranker-v2-m3
RERANKER_TOP_K=5
ADAPTIVE_RETRIEVAL_FETCH_POOL=64
ADAPTIVE_RETRIEVAL_MAX=24

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=documents

POSTGRES_DSN=postgresql+asyncpg://user:password@localhost:5432/ragdb

CHUNK_SIMILARITY_THRESHOLD=0.55
CHUNK_MAX_TOKENS=512


# 워커/품질 게이트
WORKER_CLAIM_BATCH_SIZE=4
PIPELINE_ROUND_DOCUMENT_LIMIT=16
EMBEDDING_CLAIM_BATCH_SIZE=32
WORKER_STALE_AFTER_MINUTES=30
OCR_QUALITY_GATE_ENABLED=true
OCR_QUALITY_MIN_SCORE=0.45
OCR_FALLBACK_MIN_SCORE=0.60
PDF_DIGITAL_MIN_CHARS=20
PDF_NATIVE_QUALITY_MIN_SCORE=0.20
PDF_MIXED_IMAGE_COVERAGE=0.55
PDF_MIXED_MAX_NATIVE_CHARS=400
AUTO_GENERATE_LABELS_ENABLED=true
AUTO_RECLASSIFY_LABELS_ENABLED=false

# 이미지(그림/차트) 캡셔닝 — 답변에 관련 이미지를 같이 보여주는 기능
# 기본은 꺼져있음(false) — 켜려면 Ollama에 Vision-LLM(예: qwen2-vl)을 받아둬야 함
VLM_PROVIDER_BASE_URL=http://localhost:11434
VLM_MODEL_NAME=qwen3-vl:2b-instruct
IMAGE_STORAGE_DIR=./uploaded_files/images
